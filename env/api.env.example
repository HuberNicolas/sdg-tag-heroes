OPENAI_API_KEY=""
# Chat model of the GPT assistant: "openai" (needs OPENAI_API_KEY) or "ollama" (local, free)
LLM_PROVIDER=openai
# Optional: model name (default gpt-4o-2024-08-06 for OpenAI, llama3.1 for Ollama)
LLM_MODEL=
# Optional: Ollama's OpenAI-compatible endpoint (default in Docker: http://host.docker.internal:11434/v1)
OLLAMA_BASE_URL=
